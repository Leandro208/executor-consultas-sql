# Copie para .env e ajuste se necessario.
# A chave Fernet protege as senhas das conexoes do banco.
# Gere uma nova com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EXECUTOR_SECRET_KEY=
# Onde o SQLite de metadados fica (padrao: instance/executor.db)
EXECUTOR_DATABASE_URL=
# Interface de escuta (padrao 127.0.0.1)
EXECUTOR_HOST=127.0.0.1
EXECUTOR_PORT=5000
